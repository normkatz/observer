# Production only. Store at /etc/observer/.env; no credentials here.
DB_MODE=rds
AWS_REGION=us-east-1
DB_ENDPOINT=YOUR_INSTANCE.YOUR_ID.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_NAME=observer
DB_SECRET_ARN=arn:aws:secretsmanager:us-east-1:YOUR_ACCOUNT:secret:observer/production/database-SUFFIX
# Used only by `src/storage/cli.js up`.
DB_MIGRATION_SECRET_ARN=arn:aws:secretsmanager:us-east-1:YOUR_ACCOUNT:secret:observer/production/migrations-SUFFIX
DB_TLS_CA_FILE=/etc/observer/rds-ca.pem
SAMPLE_INTERVAL_SECONDS=15
OBSERVATION_RETENTION_SECONDS=3600
INCIDENT_RETENTION_DAYS=7
LOG_DIRECTORY=/var/log/observer
STATE_DIRECTORY=/var/lib/observer
OBSERVER_APACHE_ENABLED=false
OBSERVER_CPU_ENABLED=false
OBSERVER_PROCESSES_ENABLED=false
OBSERVER_MEMORY_ENABLED=false
CPU_HIGH_PERCENT=90
CPU_RECOVERY_PERCENT=80
MEMORY_HIGH_PERCENT=90
MEMORY_RECOVERY_PERCENT=80
PROCESSES_HIGH_PERCENT=50
PROCESSES_RECOVERY_PERCENT=30
SYSTEM_TRIGGER_SAMPLES=2
SYSTEM_RECOVERY_SAMPLES=2
PROCESSES_TOP_N=10
PROCESSES_SCAN_LIMIT=4096
PROCESSES_SCAN_BUDGET_MS=1000
PENDING_SAMPLE_LIMIT=960
APACHE_LOG_PATH=/var/log/apache2/wordpress_access.log
NOTIFICATIONS_ENABLED=false
