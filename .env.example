# Local development only. No passwords or production tunnel connections.
DB_SOCKET_PATH=/opt/homebrew/var/mariadb/mariadb.sock
DB_USER=norm
DB_NAME=observer
SAMPLE_INTERVAL_SECONDS=15
OBSERVATION_RETENTION_SECONDS=3600
INCIDENT_RETENTION_DAYS=7
LOG_DIRECTORY=var/log
STATE_DIRECTORY=var/state
QUEUED_SAMPLE_LIMIT=960
# Sustained request-rate detection; tune against your normal traffic.
APACHE_REQUEST_RATE_THRESHOLD=5
APACHE_RECOVERY_RATE_THRESHOLD=2
APACHE_TRIGGER_SAMPLES=2
APACHE_RECOVERY_SAMPLES=2
APACHE_MAX_READ_BYTES=1048576
OBSERVER_CPU_ENABLED=false
OBSERVER_PROCESSES_ENABLED=false
OBSERVER_MEMORY_ENABLED=false
# Percentages use total host capacity; memory use is based on MemAvailable.
CPU_HIGH_PERCENT=90
CPU_RECOVERY_PERCENT=80
MEMORY_HIGH_PERCENT=90
MEMORY_RECOVERY_PERCENT=80
PROCESSES_HIGH_PERCENT=50
PROCESSES_RECOVERY_PERCENT=30
SYSTEM_TRIGGER_SAMPLES=2
SYSTEM_RECOVERY_SAMPLES=2
PROCESSES_TOP_N=10
PROCESSES_SCAN_LIMIT=4096
PROCESSES_SCAN_BUDGET_MS=1000
OBSERVER_APACHE_ENABLED=false
OBSERVER_WORDPRESS_ENABLED=false
OBSERVER_CIVICRM_ENABLED=false
OBSERVER_DATABASE_ENABLED=false
# Ubuntu: /var/log/apache2/wordpress_access.log
APACHE_LOG_PATH=/opt/homebrew/var/log/httpd/access_log
WORDPRESS_LOG_PATH=/srv/wp-content/debug.log
CIVICRM_LOG_PATTERN=/srv/wp-content/uploads/civicrm/ConfigAndLog/CiviCRM.*.log
NOTIFICATIONS_ENABLED=false
AWS_REGION=us-east-1
EMAIL_FROM=no-reply@fjmc.org
EMAIL_TO=wpadmin@fjmc.org
