{
  "name": "observer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.4.0"
  },
  "scripts": {
    "db:check": "node scripts/start.mjs check",
    "db:status": "node scripts/start.mjs status",
    "db:migrate": "node scripts/start.mjs up",
    "test": "node --test test/*.test.js",
    "test:integration": "node --env-file-if-exists=.env --test test/integration/*.test.js",
    "start": "node scripts/start.mjs start",
    "report": "node scripts/start.mjs report",
    "burst": "node scripts/burst.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "3.1143.0",
    "@aws-sdk/credential-providers": "3.1143.0",
    "mariadb": "3.5.4",
    "pino": "10.3.1",
    "proper-lockfile": "4.1.2",
    "rotating-file-stream": "3.2.10",
    "umzug": "3.8.3"
  }
}
